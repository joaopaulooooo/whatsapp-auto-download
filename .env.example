# Download Directory - onde os arquivos serão salvos
# Pode ser um caminho relativo (./downloads) ou absoluto (/path/to/downloads)
DOWNLOAD_DIR=./whatsapp-downloads

# File Cleanup (hours)
# CLEANUP_AFTER_HOURS: idade dos arquivos para serem deletados
# CLEANUP_INTERVAL_HOURS: frequência da limpeza automática
CLEANUP_AFTER_HOURS=72
CLEANUP_INTERVAL_HOURS=6
